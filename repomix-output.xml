"""
vision_agent.py — Vision Agent for image analysis and OCR interpretation.
"""
from __future__ import annotations
import base64
from langchain_core.language_models import BaseChatModel
from langchain_core.messages import HumanMessage
from langchain_core.output_parsers import StrOutputParser
from config.logger import get_logger

logger = get_logger(__name__)

class VisionAgent:
    name = "VisionAgent"
    description = "Interprets images and OCR text."

    def __init__(self, llm: BaseChatModel) -> None:
        self._llm = llm
        self._parser = StrOutputParser()
        logger.info("VisionAgent initialised")

    def run(
        self,
        query: str,
        ocr_text: str = "",
        image_bytes: bytes | None = None,
        chat_history: list | None = None,
    ) -> str:
        # Si tenemos imagen, la enviamos directamente al LLM
        if image_bytes:
            try:
                b64 = base64.b64encode(image_bytes).decode("utf-8")
                message = HumanMessage(content=[
                    {
                        "type": "image_url",
                        "image_url": {"url": f"data:image/jpeg;base64,{b64}"},
                    },
                    {"type": "text", "text": query},
                ])
                response = self._llm.invoke([message])
                return self._parser.invoke(response)
            except Exception as exc:
                logger.warning("Multimodal failed: %s", exc)

        # Fallback: solo texto OCR
        combined = query
        if ocr_text:
            combined = f"OCR text:\n{ocr_text}\n\nQuestion: {query}"
        response = self._llm.invoke(combined)
        return self._parser.invoke(response)
